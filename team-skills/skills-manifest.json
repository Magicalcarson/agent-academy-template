{
  "version": 1,
  "description": "Central team-skill store. sync-skills.ps1 realizes this manifest onto each CLI surface: a junction where the skill is identical everywhere, a mirror (optionally with a per-surface variant overlay) where it is not. Any existing directory is backed up to the Recycle Bin before it is replaced.",
  "canonicalStore": "team-skills",
  "homeRelativeSurfaces": true,
  "surfaces": {
    "claude": ".claude/skills",
    "codex": ".codex/skills",
    "kimi": ".agents/skills",
    "antigravity": ".gemini/config/skills"
  },
  "_perSurfaceMode_note": "Antigravity's skill loader skips reparse points - it discovers only real directories - so junctions are invisible to it. Force mirror there. Claude, Codex, and Kimi load junctions correctly.",
  "_surfaces_note": "A skill's 'surfaces' list is also its uninstall instruction. The reconcile pass removes any on-surface copy of a manifest skill that no longer lists that surface, so setting surfaces to [] uninstalls it everywhere while keeping the source versioned here.",
  "_leaveUntouched_note": "Names the installer must never create, replace, or reclaim on a given surface. Use it for vendor-native tooling that ships with a CLI, and for anything you authored directly on one surface.",
  "_source_note": "Third-party skills retain their upstream attribution and license. Preserve these fields when redistributing.",
  "perSurfaceMode": {
    "antigravity": "mirror"
  },
  "leaveUntouched": {
    "codex": [".system"]
  },
